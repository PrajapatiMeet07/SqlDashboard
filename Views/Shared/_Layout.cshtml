<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - SqlDashboard</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header style="background:#0b3d91;color:white;padding:10px 20px;">
        <h1 style="margin:0;font-size:1.25rem;">SqlDashboard</h1>
    </header>

    <main style="padding:20px;">
        @RenderBody()
    </main>

    <footer style="padding:10px 20px;color:#666;">
        <small>© SqlDashboard</small>
    </footer>
</body>
</html>
