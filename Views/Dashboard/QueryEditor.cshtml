@model SqlDashboard.Models.QueryModel
@using System.Data

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />

<style>
:root {
    --glass: rgba(255,255,255,.75);
    --border: rgba(255,255,255,.4);
    --shadow: 0 20px 45px rgba(0,0,0,.12);
}

body {
    margin: 0;
    font-family: 'Inter', sans-serif;
    background:
        radial-gradient(circle at 15% 15%, #c7d2fe, transparent 40%),
        radial-gradient(circle at 85% 10%, #bae6fd, transparent 40%),
        #f8fafc;
}

.app {
    height: 100vh;
    display: grid;
    grid-template-columns: 260px 1fr 360px;
    gap: 18px;
    padding: 18px;
}

/* ===== PANELS ===== */
.panel {
    background: var(--glass);
    backdrop-filter: blur(16px);
    border: 1px solid var(--border);
    border-radius: 22px;
    box-shadow: var(--shadow);
    padding: 16px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
}

/* ===== SIDEBAR ===== */
.sidebar h6 {
    font-weight: 600;
    margin-bottom: 10px;
}

.table-btn {
    all: unset;
    display: block;
    width: 100%;
    padding: 10px 12px;
    border-radius: 12px;
    cursor: pointer;
    color: #334155;
    transition: background .15s, transform .15s;
}

.table-btn:hover {
    background: rgba(99,102,241,.12);
    transform: translateX(4px);
}

/* ===== CENTER ===== */
.header {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.query-box textarea {
    border-radius: 14px;
    resize: none;
    border: 1px solid #e5e7eb;
}

.results {
    margin-top: 14px;
    overflow: auto;
}

.results table {
    border-collapse: separate;
    border-spacing: 0 10px;
}

.results tbody tr {
    background: white;
    border-radius: 16px;
    cursor: pointer;
    transition: transform .15s, box-shadow .15s;
}

.results tbody tr:hover {
    transform: scale(1.01);
    box-shadow: 0 14px 30px rgba(0,0,0,.15);
}

.results td, .results th {
    border: none;
    padding: 12px;
}

/* ===== IMAGE STAGE ===== */
.preview-stage {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    }

.panel-title {
    font-weight: 600;
    font-size: 14px;
    color: #334155;
    padding-bottom: 10px;
    margin-bottom: 14px;
    border-bottom: 1px solid rgba(0,0,0,.08);
    text-align: left;
}

.preview-content {
    flex: 1;
    width: 100%;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 24px;
    /* flex-direction: column; */
}


#imagePreview {
    width: 100%;
    height: auto;
    max-height: 90vh;
    object-fit: contain;
    display: none;
    border-radius: 16px;
    box-shadow: 0 30px 60px rgba(0,0,0,.28);
    transform: translateY(-10px);
     cursor: zoom-in;
}


@@keyframes fadeZoom {
    from { opacity: 0; transform: scale(.96); }
    to   { opacity: 1; transform: scale(1); }
}

.placeholder {
    color: #64748b;
    text-align: center;
    font-size: 15px;
}
.query-error {
    background: rgba(239,68,68,.08);
    color: #991b1b;
    border-left: 4px solid #ef4444;
    padding: 10px 12px;
    border-radius: 8px;
    font-size: 13px;
    line-height: 1.4;
}

</style>

<div class="app">

    <!-- LEFT -->
    <div class="panel sidebar">
        <h6>Database</h6>
        <form asp-action="ChangeDatabase" method="post">
            <select name="databaseName"
                    class="form-select mb-3"
                    onchange="this.form.submit()">
                @foreach (var db in Model.AvailableDatabases)
                {
                    <option selected="@(db == Model.SelectedDatabase)">@db</option>
                }
            </select>
        </form>

        <h6>Tables</h6>
        <div class="flex-grow-1 overflow-auto">
            @foreach (var t in Model.Tables)
            {
                <form asp-action="RunQuery" method="post">
                    <input type="hidden" name="query" value="SELECT TOP 100 * FROM [@t]" />
                    <button class="table-btn">@t</button>
                </form>
            }
        </div>
    </div>


    <!-- CENTER -->
    <div class="panel">
        <div class="header mb-2">
            <h6>Query Editor</h6>
            <form asp-action="Disconnect" method="post">
                <button class="btn btn-outline-danger btn-sm">Disconnect</button>
            </form>
        </div>

        <form asp-action="RunQuery" method="post" class="query-box">
    <textarea name="query"
              rows="4"
              class="form-control"
              id="queryBox">@Model.Query</textarea>

    <button class="btn btn-primary mt-2">Run</button>

    @* ERROR SHOWN ONLY HERE *@
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="query-error mt-2">
            @Model.ErrorMessage
        </div>
    }
</form>

        @if (Model.ResultTable != null)
        {
            <div class="results">
                <table class="table">
                    <thead>
                        <tr>
                            @foreach (DataColumn c in Model.ResultTable.Columns)
                            {
                                <th>@c.ColumnName</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (DataRow row in Model.ResultTable.Rows)
                        {
                            string? imageValue = null;

                            foreach (DataColumn col in Model.ResultTable.Columns)
                            {
                                var name = col.ColumnName.ToLower();
                                if (name.Contains("image") || name.Contains("path"))
                                {
                                    if (row[col] != DBNull.Value)
                                    {
                                        imageValue = row[col].ToString();
                                        break;
                                    }
                                }
                            }

                            <tr class="result-row" data-image="@imageValue">
                                @foreach (DataColumn col in Model.ResultTable.Columns)
                                {
                                    <td>@row[col]</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!-- RIGHT -->
<div class="panel preview-stage">

    <!-- PANEL TITLE -->
    <div class="panel-title">
        Image Preview
    </div>

    <!-- CONTENT -->
    <div class="preview-content">
        <img id="imagePreview" />

        <div id="noImageText" class="placeholder">
            Select a row to preview image
        </div>
    </div>

</div>

</div>

<script>
document.addEventListener("click", e => {
    const row = e.target.closest(".result-row");
    if (!row) return;

    const path = row.dataset.image;
    if (!path) return;

    const img = document.getElementById("imagePreview");
    const txt = document.getElementById("noImageText");

    img.src = "/Dashboard/ViewTransactionImage?path=" + encodeURIComponent(path);
    img.style.display = "block";
    resetZoom();
    txt.style.display = "none";
});
</script>

<script>
const errorText = `@Model.ErrorMessage`;

if (errorText.includes("Invalid object name")) {
    fetch("/Dashboard/QuerySuggestions?term=")
        .then(r => r.json())
        .then(data => {
            if (data.length) {
                const sugg = document.getElementById("suggestions");
                sugg.innerHTML = "";
                data.forEach(s => {
                    const item = document.createElement("button");
                    item.className = "list-group-item list-group-item-action";
                    item.textContent = "Did you mean: " + s;
                    item.onclick = () => {
                        queryBox.value += " " + s;
                        sugg.style.display = "none";
                        queryBox.focus();
                    };
                    sugg.appendChild(item);
                });
                sugg.style.display = "block";
            }
        });
}
</script>
<script>
let zoomScale = 1;
const MIN_ZOOM = 1;
const MAX_ZOOM = 5;
const ZOOM_STEP = 0.15;

const img = document.getElementById("imagePreview");

function resetZoom() {
    zoomScale = 1;
    img.style.transform = "scale(1)";
    img.style.transformOrigin = "center center";
}

// Mouse-wheel zoom
img.addEventListener("wheel", function (e) {
    if (!img.src) return;

    e.preventDefault();

    const rect = img.getBoundingClientRect();

    // Zoom towards cursor
    const offsetX = ((e.clientX - rect.left) / rect.width) * 100;
    const offsetY = ((e.clientY - rect.top) / rect.height) * 100;

    img.style.transformOrigin = `${offsetX}% ${offsetY}%`;

    if (e.deltaY < 0) {
        zoomScale = Math.min(zoomScale + ZOOM_STEP, MAX_ZOOM);
    } else {
        zoomScale = Math.max(zoomScale - ZOOM_STEP, MIN_ZOOM);
    }

    img.style.transform = `scale(${zoomScale})`;
});
</script>
